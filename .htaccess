# SPACE PLANNERS INDIA - ERROR DOCUMENTS & REWRITE RULES
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # --- 0. Enforce HTTPS & Apex Domain (www -> apex, http -> https) ---
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP_HOST} ^www\.(.+) [NC]
    RewriteRule ^ https://spaceplannersindia.in%{REQUEST_URI} [R=301,L]

    # --- 1. 301 Permanent Redirects for Old WordPress Permalinks ---
    RewriteRule ^contact-us/?$ /contact.html [R=301,L]
    RewriteRule ^about-us/?$ /about.html [R=301,L]
    RewriteRule ^compactor-storage-system/?$ /compactor-storage.html [R=301,L]
    RewriteRule ^heavy-duty-compactors-storage-system/?$ /compactor-storage.html [R=301,L]
    RewriteRule ^industrial-racking-system/?$ /industrial-racks.html [R=301,L]
    RewriteRule ^storage-lockers-system/?$ /storage-lockers.html [R=301,L]
    RewriteRule ^filing-cabinets-system/?$ /filing-cabinets.html [R=301,L]
    RewriteRule ^our-projects/?$ /projects.html [R=301,L]
    RewriteRule ^privacy-policy-2/?$ /privacy-policy.html [R=301,L]
    RewriteRule ^wp-content/.*$ /404.html [R=404,L]
    RewriteRule ^wp-admin/.*$ /404.html [R=404,L]
    RewriteRule ^index\.php$ / [R=301,L]
    Redirect 301 /heavy-duty-compactors-storage-system/ https://spaceplannersindia.in/compactor-storage.html
    Redirect 301 /unleashing-the-potential-of-space-transforming-your-environment-with-space-planners-india/ https://spaceplannersindia.in/about.html

    # --- 2. Clean URLs (allow accessing /contact or /about without .html extension) ---
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
# Prevent clickjacking
Header always set X-Frame-Options "SAMEORIGIN"
    
# Prevent MIME-sniffing
Header always set X-Content-Type-Options "nosniff"
    
# Enable Cross-Site Scripting (XSS) filter built into browsers
Header always set X-XSS-Protection "1; mode=block"
    
# Strict-Transport-Security (HSTS) - enforce HTTPS
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
# Referrer Policy
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Content Security Policy (CSP) - Updated for reCAPTCHA and mailto:
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://maps.googleapis.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://www.google-analytics.com https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; img-src 'self' data: https: https://www.google-analytics.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src 'self' https://www.google.com/recaptcha/ https://recaptcha.google.com/; connect-src 'self' https://ad.doubleclick.net https://www.google-analytics.com https://www.google.com https://www.googletagmanager.com https://api.web3forms.com https://*.googleapis.com https://*.gstatic.com; report-uri /csp-violation-report-endpoint/"
</IfModule>

# COMPRESSION (GZIP / BROTLI)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml font/woff2
</IfModule>

# CACHING LIFETIMES & IMMUTABLE HEADERS
<IfModule mod_expires.c>
ExpiresActive On
    
# Images & Fonts
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/gif "access plus 1 year"
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType image/x-icon "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"

# CSS & JavaScript
ExpiresByType text/css "access plus 1 year"
ExpiresByType text/javascript "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
    
# Others
ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(ico|jpe?g|png|gif|swf|svg|webp|woff2|css|js)$">
Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>
</IfModule>


